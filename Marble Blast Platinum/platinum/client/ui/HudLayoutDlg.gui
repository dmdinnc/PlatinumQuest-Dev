		});

		%row.add(new GuiMLTextCtrl("HudLayoutOffsetYDisplay" @ %name) {
			profile = "GuiMLTextProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "390 74";
			extent = "50 26";
			minExtent = "8 8";
			visible = "1";
			helpTag = "0";
			lineSpacing = "2";
			allowColorChars = "0";
			maxChars = "-1";
		});

		// Disabled overlay shown in Default/Centered modes
		%row.add(new GuiControl("HudLayoutDisabledOverlay" @ %name) {
			profile = "HudLayoutDisabledRowProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "0 0";
			extent = "440 100";
			minExtent = "8 8";
			visible = "0";
			helpTag = "0";
		});

		HudLayoutContent.add(%row);
		%this.refreshRow(%name);
	}
}

function HudLayoutDlg::refreshModeState(%this) {
	%mode = $pref::HudLayoutMode;
	if (%mode $= "")
		%mode = 0;
	HudLayoutModeDisplay.setText("<bold:24>" @ $HudLayout::ModeName[%mode]);
	%this.refreshEnabledState();
}

function HudLayoutDlg::refreshEnabledState(%this) {
	%mode = $pref::HudLayoutMode;
	if (%mode $= "")
		%mode = 0;
	%active = (%mode == 2);

	for (%i = 0; %i < $HudLayout::ElementCount; %i++) {
		%name = $HudLayout::ElementName[%i];
		%rowName = "HudLayoutRow" @ %name;
		%overlay = "HudLayoutDisabledOverlay" @ %name;
		if (isObject(%rowName)) {
			%rowName.setActive(%active);
		}
		if (isObject(%overlay)) {
			%overlay.setVisible(!%active);
		}
	}

	if (%mode == 0) {
		for (%i = 0; %i < $HudLayout::ElementCount; %i++) {
			%this.loadRowFromPreset($HudLayout::ElementName[%i], "Default");
		}
	} else if (%mode == 1) {
		for (%i = 0; %i < $HudLayout::ElementCount; %i++) {
			%this.loadRowFromPreset($HudLayout::ElementName[%i], "Centered");
		}
	} else {
		for (%i = 0; %i < $HudLayout::ElementCount; %i++) {
			%this.refreshRow($HudLayout::ElementName[%i]);
		}
	}

	%this.updatePreview();

	if (isObject(PlayGui) && RootGui.getContent() == PlayGui) {
		PlayGui.applyUISettings();
	}
}

function HudLayoutDlg::loadRowFromPreset(%this, %name, %preset) {
	$HudLayout::UpdatingUI = true;
	%anchor = HudLayout::getPresetValue(%preset, %name, "Anchor", 4);
	%offsetX = HudLayout::getPresetValue(%preset, %name, "OffsetX", 0);
	%offsetY = HudLayout::getPresetValue(%preset, %name, "OffsetY", 0);

	%anchorCtrl = "HudLayoutAnchorValue" @ %name;
	%xSlider = "HudLayoutOffsetXSlider" @ %name;
	%xDisplay = "HudLayoutOffsetXDisplay" @ %name;
	%ySlider = "HudLayoutOffsetYSlider" @ %name;
	%yDisplay = "HudLayoutOffsetYDisplay" @ %name;

	if (isObject(%anchorCtrl))
		%anchorCtrl.setText("<bold:20>" @ PlayGui::getHudAnchorName(%anchor));
	if (isObject(%xSlider))
		%xSlider.setValue(%offsetX);
	if (isObject(%xDisplay))
		%xDisplay.setText("<bold:20>" @ %offsetX);
	if (isObject(%ySlider))
		%ySlider.setValue(%offsetY);
	if (isObject(%yDisplay))
		%yDisplay.setText("<bold:20>" @ %offsetY);
	$HudLayout::UpdatingUI = false;
}

function HudLayoutDlg::modeDecrease() {
	%mode = $pref::HudLayoutMode;
	if (%mode $= "")
		%mode = 0;
	%mode--;
	if (%mode < 0)
		%mode = $HudLayout::ModeCount - 1;
	$pref::HudLayoutMode = %mode;
	HudLayoutDlg.refreshModeState();
}

function HudLayoutDlg::modeIncrease() {
	%mode = $pref::HudLayoutMode;
	if (%mode $= "")
		%mode = 0;
	%mode++;
	if (%mode >= $HudLayout::ModeCount)
		%mode = 0;
	$pref::HudLayoutMode = %mode;
	HudLayoutDlg.refreshModeState();
}

function HudLayoutDlg::refreshRow(%this, %name) {
	$HudLayout::UpdatingUI = true;
	%anchor = HudLayout::getPref(%name, "Anchor", 4);
	%offsetX = HudLayout::getPref(%name, "OffsetX", 0);
	%offsetY = HudLayout::getPref(%name, "OffsetY", 0);

	%anchorCtrl = "HudLayoutAnchorValue" @ %name;
	%xSlider = "HudLayoutOffsetXSlider" @ %name;
	%xDisplay = "HudLayoutOffsetXDisplay" @ %name;
	%ySlider = "HudLayoutOffsetYSlider" @ %name;
	%yDisplay = "HudLayoutOffsetYDisplay" @ %name;

	if (isObject(%anchorCtrl))
		%anchorCtrl.setText("<bold:20>" @ PlayGui::getHudAnchorName(%anchor));
	if (isObject(%xSlider))
		%xSlider.setValue(%offsetX);
	if (isObject(%xDisplay))
		%xDisplay.setText("<bold:20>" @ %offsetX);
	if (isObject(%ySlider))
		%ySlider.setValue(%offsetY);
	if (isObject(%yDisplay))
		%yDisplay.setText("<bold:20>" @ %offsetY);
	$HudLayout::UpdatingUI = false;
}

function HudLayoutDlg::shiftAnchor(%this, %name, %delta) {
	%mode = $pref::HudLayoutMode;
	if (%mode !$= "2")
		return;

	%anchor = mFloor(HudLayout::getPref(%name, "Anchor", 4) + %delta);
	if (%anchor < 0) {
		%anchor = 8;
	} else if (%anchor > 8) {
		%anchor = 0;
	}
	HudLayout::setPref(%name, "Anchor", %anchor);

	// Reset offsets to 0 when anchor changes
	HudLayout::setPref(%name, "OffsetX", 0);
	HudLayout::setPref(%name, "OffsetY", 0);

	%this.refreshRow(%name);
	%this.updatePreview();
	if (isObject(PlayGui) && RootGui.getContent() == PlayGui) {
		PlayGui.applyUISettings();
	}
}

function HudLayoutDlg::sliderChanged(%this, %name, %axis) {
	%mode = $pref::HudLayoutMode;
	if (%mode !$= "2" || $HudLayout::UpdatingUI)
		return;

	%slider = "HudLayoutOffset" @ %axis @ "Slider" @ %name;
	%display = "HudLayoutOffset" @ %axis @ "Display" @ %name;
	%value = %slider.getValue();

	// Round to whole number
	%value = mFloor(%value + 0.5);

	if (%axis $= "X") {
		HudLayout::setPref(%name, "OffsetX", %value);
	} else {
		HudLayout::setPref(%name, "OffsetY", %value);
	}

	if (isObject(%display))
		%display.setText("<bold:20>" @ %value);

	%this.updatePreview();

	if (isObject(PlayGui) && RootGui.getContent() == PlayGui) {
		PlayGui.applyUISettings();
	}
}

function HudLayoutDlg::resetDefaults(%this) {
	HudLayout::setPref("Gem", "Anchor", 0);
	HudLayout::setPref("Gem", "OffsetX", 0);
	HudLayout::setPref("Gem", "OffsetY", 0);
	HudLayout::setPref("Timer", "Anchor", 1);
	HudLayout::setPref("Timer", "OffsetX", 0);
	HudLayout::setPref("Timer", "OffsetY", 0);
	HudLayout::setPref("Powerup", "Anchor", 2);
	HudLayout::setPref("Powerup", "OffsetX", 0);
	HudLayout::setPref("Powerup", "OffsetY", 0);
	HudLayout::setPref("Blast", "Anchor", 6);
	HudLayout::setPref("Blast", "OffsetX", 0);
	HudLayout::setPref("Blast", "OffsetY", 0);

	for (%i = 0; %i < $HudLayout::ElementCount; %i++) {
		%this.refreshRow($HudLayout::ElementName[%i]);
	}
	%this.updatePreview();
	if (isObject(PlayGui) && RootGui.getContent() == PlayGui) {
		PlayGui.applyUISettings();
	}
}
