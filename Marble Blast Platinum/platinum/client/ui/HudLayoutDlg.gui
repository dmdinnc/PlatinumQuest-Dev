		%row.add(%anchorValue);

		%row.add(new GuiBorderButtonCtrl("HudLayoutAnchorInc" @ %name) {
			profile = "GuiBorderButtonProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "206 40";
			extent = "36 36";
			minExtent = "8 8";
			visible = "1";
			command = "HudLayoutDlg.shiftAnchor(\"" @ %name @ "\", 1);";
			helpTag = "0";
			text = ">";
			groupNum = "-1";
			buttonType = "PushButton";
			repeatPeriod = "400";
			repeatDecay = "1";
		});

		// --- X slider (right of anchor, same row y=40) ---
		%xLabel = new GuiMLTextCtrl("HudLayoutOffsetXLabel" @ %name) {
			profile = "GuiMLTextProfile";
			horizSizing = "right";
			vertSizing = "bottom";
